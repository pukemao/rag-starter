# LLM
DEEPSEEK_API_KEY=

# DashScope embedding, paid/quota based
DASHSCOPE_API_KEY=
# RAG_EMBEDDING_PROVIDER=dashscope
# DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
# DASHSCOPE_EMBEDDING_DIMENSION=2048

# Local Ollama embedding, free after the model is available locally
# RAG_EMBEDDING_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
# OLLAMA_EMBEDDING_DIMENSION=2560
# OLLAMA_EMBEDDING_BATCH_SIZE=10
# OLLAMA_EMBEDDING_TIMEOUT_SECONDS=120

# Reranker, improves retrieval quality after vector recall
# RAG_RERANKER_PROVIDER=bge
# RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RAG_RERANKER_DEVICE=cpu
# RAG_RERANKER_USE_FP16=false
# To use local Ollama reranker:
# RAG_RERANKER_PROVIDER=ollama
# OLLAMA_RERANKER_BASE_URL=http://127.0.0.1:11434
# OLLAMA_RERANKER_MODEL=dengcao/bge-reranker-v2-m3
# OLLAMA_RERANKER_BATCH_SIZE=4
# OLLAMA_RERANKER_TIMEOUT_SECONDS=120
# RAG_RERANKER_MAX_PASSAGE_CHARS=1500
# RAG_RETRIEVAL_MIN_CANDIDATE_K=12
# RAG_RETRIEVAL_CANDIDATE_MULTIPLIER=5
# RAG_RETRIEVAL_MAX_CANDIDATE_K=40
# RAG_TOOL_MAX_K=8
# RAG_TOOL_MAX_CALLS=3
